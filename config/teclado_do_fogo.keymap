/*
 * Keymap do Teclado do Fogo (60 teclas, 5x12).
 *
 * Pensado para o layout "US-International" no sistema operacional:
 * acentos e ç saem por dead keys (' + c = ç, ~ + a = ã, ^ + e = ê, ` + a = à).
 * Todas as dead keys (' " ` ~ ^) estão na camada base.
 *
 * Dá para editar sem recompilar pelo ZMK Studio (https://zmk.studio):
 * plugue o lado esquerdo no USB e desbloqueie com LOWER + tecla STUDIO.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE  0
#define LOWER 1

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
// ---------------------------------------------------------------------------------------------
// |   `  |  1  |  2  |  3  |  4  |  5  |     |  6  |  7   |  8  |  9  |  0  | BKSP |
// |  TAB |  Q  |  W  |  E  |  R  |  T  |     |  Y  |  U   |  I  |  O  |  P  |  \   |
// | CAPS |  A  |  S  |  D  |  F  |  G  |     |  H  |  J   |  K  |  L  |  ;  | ENT  |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |     |  N  |  M   |  ,  |  .  |  /  |  '   |
// | CTRL | ALT | GUI | SPC | ALT | GUI |     | SPC |LOWER |  ←  |  ↓  |  ↑  |  →   |
            bindings = <
   &kp GRAVE  &kp N1    &kp N2    &kp N3     &kp N4    &kp N5      &kp N6     &kp N7     &kp N8     &kp N9    &kp N0    &kp BSPC
   &kp TAB    &kp Q     &kp W     &kp E      &kp R     &kp T       &kp Y      &kp U      &kp I      &kp O     &kp P     &kp BSLH
   &kp CAPS   &kp A     &kp S     &kp D      &kp F     &kp G       &kp H      &kp J      &kp K      &kp L     &kp SEMI  &kp RET
   &kp LSHFT  &kp Z     &kp X     &kp C      &kp V     &kp B       &kp N      &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp APOS
   &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE  &kp LALT  &kp LGUI    &kp SPACE  &mo LOWER  &kp LEFT   &kp DOWN  &kp UP    &kp RIGHT
            >;
        };

        lower_layer {
            display-name = "Lower";
// ---------------------------------------------------------------------------------------------
// | ESC  |  F1  |  F2  |  F3  |  F4  |  F5  |     |  F6  |  F7  |  F8  |  F9  | F10  | DEL  |
// |      | BT1  | BT2  | BT3  | BT4  | BT5  |     |      |      |      | F11  | F12  |BT CLR|
// |      |      |      |  (   |  )   |      |     |      |  [   |  ]   |  -   |  =   |      |
// |      | PREV | PLAY | NEXT | VOL- | VOL+ |     | MUTE | HOME | PGDN | PGUP | END  |      |
// | BOOT |      |      |      |      |STUDIO|     |      |      |      |      | BOOT |
            bindings = <
   &kp ESC   &kp F1         &kp F2         &kp F3         &kp F4          &kp F5           &kp F6      &kp F7    &kp F8    &kp F9     &kp F10    &kp DEL
   &trans    &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3    &bt BT_SEL 4     &trans      &trans    &trans    &kp F11    &kp F12    &bt BT_CLR
   &trans    &trans         &trans         &kp LPAR       &kp RPAR        &trans           &trans      &kp LBKT  &kp RBKT  &kp MINUS  &kp EQUAL  &trans
   &trans    &kp C_PREV     &kp C_PP       &kp C_NEXT     &kp C_VOL_DN    &kp C_VOL_UP     &kp C_MUTE  &kp HOME  &kp PG_DN &kp PG_UP  &kp END    &trans
   &bootloader &trans       &trans         &trans         &trans          &studio_unlock   &trans      &trans    &trans    &trans     &trans     &bootloader
            >;
        };
    };
};
