#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)    RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)    RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)    RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)    RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)    RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };

    // Posições reais (unidade = 1/100 de tecla), derivadas do stagger do ergogen/config.yaml:
    // colunas da esquerda (externa -> interna) com y = [68, 68, 28, 0, 34, 51] (pitch vertical 17,75 mm); lado direito espelhado.
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Teclado do Fogo";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys  //                     w   h    x   y rot rx ry
            = <&key_physical_attrs 100 100    0  68 0 0 0>
            , <&key_physical_attrs 100 100  100  68 0 0 0>
            , <&key_physical_attrs 100 100  200  28 0 0 0>
            , <&key_physical_attrs 100 100  300   0 0 0 0>
            , <&key_physical_attrs 100 100  400  34 0 0 0>
            , <&key_physical_attrs 100 100  500  51 0 0 0>
            , <&key_physical_attrs 100 100  820  51 0 0 0>
            , <&key_physical_attrs 100 100  920  34 0 0 0>
            , <&key_physical_attrs 100 100 1020   0 0 0 0>
            , <&key_physical_attrs 100 100 1120  28 0 0 0>
            , <&key_physical_attrs 100 100 1220  68 0 0 0>
            , <&key_physical_attrs 100 100 1320  68 0 0 0>
            , <&key_physical_attrs 100 100    0 168 0 0 0>
            , <&key_physical_attrs 100 100  100 168 0 0 0>
            , <&key_physical_attrs 100 100  200 128 0 0 0>
            , <&key_physical_attrs 100 100  300 100 0 0 0>
            , <&key_physical_attrs 100 100  400 134 0 0 0>
            , <&key_physical_attrs 100 100  500 151 0 0 0>
            , <&key_physical_attrs 100 100  820 151 0 0 0>
            , <&key_physical_attrs 100 100  920 134 0 0 0>
            , <&key_physical_attrs 100 100 1020 100 0 0 0>
            , <&key_physical_attrs 100 100 1120 128 0 0 0>
            , <&key_physical_attrs 100 100 1220 168 0 0 0>
            , <&key_physical_attrs 100 100 1320 168 0 0 0>
            , <&key_physical_attrs 100 100    0 268 0 0 0>
            , <&key_physical_attrs 100 100  100 268 0 0 0>
            , <&key_physical_attrs 100 100  200 228 0 0 0>
            , <&key_physical_attrs 100 100  300 200 0 0 0>
            , <&key_physical_attrs 100 100  400 234 0 0 0>
            , <&key_physical_attrs 100 100  500 251 0 0 0>
            , <&key_physical_attrs 100 100  820 251 0 0 0>
            , <&key_physical_attrs 100 100  920 234 0 0 0>
            , <&key_physical_attrs 100 100 1020 200 0 0 0>
            , <&key_physical_attrs 100 100 1120 228 0 0 0>
            , <&key_physical_attrs 100 100 1220 268 0 0 0>
            , <&key_physical_attrs 100 100 1320 268 0 0 0>
            , <&key_physical_attrs 100 100    0 368 0 0 0>
            , <&key_physical_attrs 100 100  100 368 0 0 0>
            , <&key_physical_attrs 100 100  200 328 0 0 0>
            , <&key_physical_attrs 100 100  300 300 0 0 0>
            , <&key_physical_attrs 100 100  400 334 0 0 0>
            , <&key_physical_attrs 100 100  500 351 0 0 0>
            , <&key_physical_attrs 100 100  820 351 0 0 0>
            , <&key_physical_attrs 100 100  920 334 0 0 0>
            , <&key_physical_attrs 100 100 1020 300 0 0 0>
            , <&key_physical_attrs 100 100 1120 328 0 0 0>
            , <&key_physical_attrs 100 100 1220 368 0 0 0>
            , <&key_physical_attrs 100 100 1320 368 0 0 0>
            , <&key_physical_attrs 100 100    0 468 0 0 0>
            , <&key_physical_attrs 100 100  100 468 0 0 0>
            , <&key_physical_attrs 100 100  200 428 0 0 0>
            , <&key_physical_attrs 100 100  300 400 0 0 0>
            , <&key_physical_attrs 100 100  400 434 0 0 0>
            , <&key_physical_attrs 100 100  500 451 0 0 0>
            , <&key_physical_attrs 100 100  820 451 0 0 0>
            , <&key_physical_attrs 100 100  920 434 0 0 0>
            , <&key_physical_attrs 100 100 1020 400 0 0 0>
            , <&key_physical_attrs 100 100 1120 428 0 0 0>
            , <&key_physical_attrs 100 100 1220 468 0 0 0>
            , <&key_physical_attrs 100 100 1320 468 0 0 0>
            ;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // linha num    (P0.31)
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // linha top    (P0.29)
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // linha home   (P0.02)
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // linha bottom (P1.15)
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // linha mod    (P1.13)
            ;
    };
};
